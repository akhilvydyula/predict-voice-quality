{
  "expo": {
    "name": "Voice Quality",
    "slug": "predict-voice-quality",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "voicequality",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07050f",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voicequality.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voice Quality needs microphone access to analyze your singing in real time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.voicequality.app",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Voice Quality needs microphone access to analyze your singing in real time."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
