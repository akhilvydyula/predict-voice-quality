{
  "name": "predict-voice-quality",
  "version": "1.0.0",
  "description": "VocalIQ — open-source real-time vocal training with pitch feedback, scoring, coaching, and analytics (Expo / React Native)",
  "license": "MIT",
  "author": "Akhil Vydyula",
  "contributors": [
    "Akhil Vydyula <35249770+akhilvydyula@users.noreply.github.com> (https://github.com/akhilvydyula)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhilvydyula/predict-voice-quality.git"
  },
  "homepage": "https://predict-voice-quality.pages.dev",
  "bugs": {
    "url": "https://github.com/akhilvydyula/predict-voice-quality/issues"
  },
  "keywords": [
    "vocal-training",
    "pitch-detection",
    "singing",
    "voice-analysis",
    "expo",
    "react-native",
    "open-source",
    "music-education",
    "yin-algorithm"
  ],
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "~56.0.0",
    "expo": "~56.0.12",
    "expo-audio": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.104.0"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/prepare-cloudflare-dist.mjs",
    "deploy:cloudflare": "npm run build:web && wrangler pages deploy dist --project-name=predict-voice-quality --branch=main --commit-dirty=true",
    "api": "npm run dev --prefix server",
    "api:build": "npm run build --prefix server",
    "api:start": "npm run start --prefix server"
  }
}
